# Configuração do Banco de Dados

# Tipo de banco: 'mongodb'
DB_TYPE=mongodb

# Conexão MongoDB direta (exemplo local)
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=empresa

# Se usar autenticação, defina usuário/senha e auth source
# MONGO_USERNAME=seu_usuario
# MONGO_PASSWORD=sua_senha
# MONGO_AUTH_SOURCE=admin

# Se preferir informar host/porta separadamente, use:
# MONGO_HOST=localhost
# MONGO_PORT=27017
