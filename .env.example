# Configuração do Banco de Dados

# Tipo de banco: 'sqlserver' ou 'sqlite'
DB_TYPE=sqlserver

# Configurações SQL Server
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=empresa
DB_USERNAME=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=yes
DB_ENCRYPT=no

# Ou use SQLite (descomente a linha abaixo para usar SQLite)
# DB_TYPE=sqlite
# DB_SQLITE_PATH=database/empresa.db
